# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=ppp

# Database Host (local dev: localhost; docker-compose: db)
DB_HOST=localhost
DB_PORT=5432

# Final Connection String
# Note: URL-encode special characters in the password (e.g. '@' -> '%40').
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/ppp
